      "name": "container420",
      "args": [
        "exec",
        "-i",
        "bookly-frontend",
        "node",
        "-e",
        "(function () {\n  const f = require('node:fs'), c = require('node:crypto'); let data = '';\n  process.stdin.setEncoding('utf8'); process.stdin.on('data', x => data += x);\n  process.stdin.on('end', () => {\n    const files = Object.entries(JSON.parse(data)).map(([rel, expected]) => {\n      try {return {rel, expected, actual: c.createHash('sha256').update(f.readFileSync('/app/' + rel.replace(/\\\\/g, '/'))).digest('hex'), error: null};}\n      catch (e) {return {rel, expected, actual: null, error: e.code || String(e)};}\n    });\n    process.stdout.write(JSON.stringify({node: process.version, next: require('/app/node_modules/next/package.json').version, buildId: f.readFileSync('/app/.next/BUILD_ID', 'utf8').trim(), files}));\n  });\n})();"
      ],
