{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/en/tours/hidden-gems-rome-walking-tour"
      ],
      "numberOfRuns": 1,
      "settings": {
        "saveAssets": true
      },
      "chromePath": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
      "puppeteerScript": "scripts\\lighthouse-browser-ready.cjs",
      "puppeteerLaunchOptions": {
        "headless": true,
        "args": [
          "--no-sandbox",
          "--disable-dev-shm-usage"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "pessimistic"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
