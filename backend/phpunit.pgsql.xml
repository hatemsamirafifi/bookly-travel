<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit config for running the test suite against PostgreSQL (the prod
    schema uses pgsql-specific CHECK constraints that sqlite cannot run).

    Used in-container after starting docker-compose.test.yml. phpunit.xml.dist
    is equivalent; this named file remains for explicit PostgreSQL runs.

    Targets the disposable bookly-test-postgres service so the development
    PostgreSQL server is never touched
    by RefreshDatabase. Scout uses the in-memory collection driver and the sync
    queue connection so tests stay isolated and deterministic (no Meilisearch or
    Redis dependency).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="bookly-test-postgres" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="bookly_test" force="true"/>
        <env name="DB_USERNAME" value="bookly_test" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="SCOUT_DRIVER" value="collection" force="true"/>
        <env name="SCOUT_PREFIX" value="bookly_test_" force="true"/>
        <env name="MEILISEARCH_HOST" value="http://bookly-test-meilisearch:7700" force="true"/>
        <env name="MEILISEARCH_KEY" value="test-key" force="true"/>
        <env name="SCOUT_QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SCOUT_QUEUE" value="default" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!-- Mirror the bootstrap values in every PHP environment adapter. -->
        <server name="APP_ENV" value="testing"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_HOST" value="bookly-test-postgres"/>
        <server name="DB_PORT" value="5432"/>
        <server name="DB_DATABASE" value="bookly_test"/>
        <server name="DB_USERNAME" value="bookly_test"/>
        <server name="DB_PASSWORD" value=""/>
        <server name="DB_URL" value=""/>
        <server name="CACHE_STORE" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="SCOUT_DRIVER" value="collection"/>
        <server name="SCOUT_QUEUE_CONNECTION" value="sync"/>
        <server name="SCOUT_QUEUE" value="default"/>
    </php>
</phpunit>
